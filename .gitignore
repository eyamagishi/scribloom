# .gitignore

# ========================
# Python 一般
# ========================
__pycache__/
*.py[cod]
*.egg-info/
*.sqlite3
.env

# ========================
# Poetry
# ========================
# poetry.lock はバージョン管理すべきなので除外しない

# ========================
# エディタ・IDE
# ========================
.vscode/

# ========================
# Streamlit
# ========================
# config.toml は必要なので除外しない
# secrets.toml は機密情報を含む可能性があるため除外
.streamlit/secrets.toml

# ========================
# テスト・カバレッジ
# ========================
.coverage
.pytest_cache/
htmlcov/

# ========================
# アプリケーションデータ
# ========================
data/posts.json
